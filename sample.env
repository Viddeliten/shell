# Copy this file to .env and set the values for this site.
# docker compose reads .env automatically.

# Site name shown on the page
SITE_NAME=Example Site

# Port on localhost. Use a different one per site to run several at once.
APP_PORT=8080

# Local development database
DB_NAME=site
DB_USER=site
DB_PASSWORD=site
DB_ROOT_PASSWORD=local-root-password
